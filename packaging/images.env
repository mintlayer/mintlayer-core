# Container image pins for the packaging pipeline.
# Single source of truth for both CI (.github/workflows/release_linux.yml)
# and local testing (packaging/test-local.sh) — keep pins in one place here.
# Bump deliberately: a new pin should be tested with a full test-local.sh run.

# Fedora (rpm builder); pinned for reproducible packaging.
FEDORA_IMAGE=fedora:44

# Arch (pkg builder); pinned to a dated snapshot of the rolling images.
# Note: amd64 only — the aarch64 leg repackages cross-target (see
# packaging/arch/build.sh). The pin covers the base image only: build.sh
# runs `pacman -Syu`, so package versions drift until the pin is bumped.
ARCH_IMAGE=archlinux:base-20260913.0.592969
